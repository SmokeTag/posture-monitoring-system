% Referências (ABNT via abntex2cite, estilo abntex2-alf). Chaves: sobrenomeANO, ex.: okezue2020.
% Fonte: report/final/referencias.tex (já conferida).
% Notas de formatação (abntex2-alf.bst):
%  - o .bst não tem campo `doi`: o DOI sai pelo campo `note` ("DOI: \abntdoi{...}");
%    \abntdoi (definido no @preamble abaixo) = \url sem os < > que o
%    abntex2cite põe em toda URL; quebra a linha sem inserir hífen.
%    O campo `doi` fica só como metadado (ignorado pelo estilo).
%  - número de artigo eletrônico (e21105, 5430...) vai junto do `number`
%    (ou do `volume`, quando não há número) para sair "n. 1, e21105" sem "p.".
%  - acentos em nomes/eventos como {\'O}, {\~a}, {\^e}: o BibTeX só converte
%    para maiúsculas os acentos escritos assim.
%  - sem data: year = {{[2012?a]}} (data provável, NBR 6023); as chaves extras
%    protegem os colchetes dentro do \bibitem[...] gerado.
%  - autor-entidade em CAIXA ALTA entre chaves duplas, para a citação sair
%    (INTERLINK ELECTRONICS, [2012?a]).

@preamble{ "\providecommand{\abntdoi}{}\DeclareUrlCommand\abntdoi{\def\UrlLeft{}\def\UrlRight{}}" }

